{
  "trailingSlash": false,
  "redirects": [
    { "source": "/login", "destination": "/app", "permanent": false },
    { "source": "/signup", "destination": "/app?signup=1", "permanent": false }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/:path*", "destination": "/app/index.html" },
    { "source": "/:page(terms|privacy|cookies|dpa|subprocessors|acceptable-use|refunds|contact|help)", "destination": "/app/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
